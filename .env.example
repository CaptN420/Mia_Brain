# Example environment for Captn. COPY to `.env` and fill in — `.env` is gitignored.
# Prefer env vars over files so secrets never sit in the repo tree.

# Access passphrase for the dashboard login gate. If set, ALL remote visitors must
# supply it. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CAPTN_AUTH_PASSPHRASE=

# Force local clients (127.0.0.1) to authenticate too (defense in depth).
# CAPTN_AUTH_ENFORCE_LOCAL=1

# GitHub PAT (optional, raises crawl rate limit). Prefer this over pasting into the UI.
# GITHUB_TOKEN=

# OpenAI-compatible provider (optional). base_url lets you point at Ollama/LM Studio.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

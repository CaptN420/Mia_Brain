      },
      "family": "cinetique",
      "micro_equation": "",
      "experiment": "",
      "approved": true,
      "source_turn": 5,
      "source_agent": "Hermes",
      "validation_summary": "Variable : k_eff\nFamille : diffusivit\u00e9\nD\u00e9finition : Coefficient de transfert de la mati\u00e8re entre deux phases ou milieux.\nUnit\u00e9 : m\u00b2/s\nMesure : Mesure de la diffusivit\u00e9 effective de la mati\u00e8re dans un milieu donn\u00e9.\nR\u00f4le causal : Diminue la concentration de la mati\u00e8re en augmentant la diffusion.\nLiens :\n-  k_eff diminue la concentration de la mati\u00e8re en augmentant la diffusion."
    },
